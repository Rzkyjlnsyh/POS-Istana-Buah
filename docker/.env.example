# ==============================================================================
# Konfigurasi Infrastruktur Docker Compose — Istana Buah POS (ENV-005)
# Salin file ini ke `docker/.env` di server VPS dan ganti seluruh nilai rahasia.
# ==============================================================================

# Environment file aplikasi backend (relatif terhadap folder `docker/`)
API_ENV_FILE=../apps/api/.env.example

# Domain & Port Publik
APP_DOMAIN=app.istanabuah.com
API_DOMAIN=api.istanabuah.com
HTTP_PORT=80
HTTPS_PORT=443
API_PORT=3000
API_UPSTREAM_PORT=3000
CLIENT_MAX_BODY_SIZE=10M

# Frontend Build Arguments (Vite)
VITE_API_BASE_URL=https://api.istanabuah.com/v1
VITE_APP_NAME=Istana Buah Semarang
VITE_OFFLINE_SYNC_INTERVAL=30000
VITE_PRODUCT_CACHE_TTL=300000

# PostgreSQL 16
POSTGRES_DB=istanabuah
POSTGRES_USER=istanabuah_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

# Redis 7
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

