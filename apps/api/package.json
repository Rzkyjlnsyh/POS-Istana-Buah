{
  "name": "@istana-buah/api",
  "version": "1.0.0",
  "private": true,
  "description": "Istana Buah POS - Backend API (Express + TypeScript)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx ../../scripts/seed.ts",
    "prebuild": "pnpm --filter @istana-buah/shared build && prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "pnpm --filter @istana-buah/shared build && prisma generate",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @istana-buah/shared build && prisma generate",
    "test": "jest --coverage"
  },
  "dependencies": {
    "@istana-buah/shared": "workspace:*",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "winston": "^3.17.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.6",
    "@types/supertest": "^6.0.2",
    "embedded-postgres": "16.15.0-beta.19",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "redis-memory-server": "^0.17.1",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.0",
    "tsx": "^4.19.0"
  }
}
