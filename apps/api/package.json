{
  "name": "@istana-buah/api",
  "version": "1.0.0",
  "private": true,
  "description": "Istana Buah POS - Backend API (Express + TypeScript)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "prebuild": "pnpm --filter @istana-buah/shared build",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "pnpm --filter @istana-buah/shared build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @istana-buah/shared build",
    "test": "jest --coverage"
  },
  "dependencies": {
    "@istana-buah/shared": "workspace:*",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "winston": "^3.17.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.0",
    "tsx": "^4.19.0"
  }
}
