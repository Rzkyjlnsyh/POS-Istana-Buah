# Salin ke .env lalu isi dengan nilai sesuai environment. JANGAN commit file .env.
# Seluruh nilai konfigurasi berasal dari environment (tanpa hardcode di kode).

# Server
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
APP_NAME="Istana Buah Semarang"
APP_VERSION=1.0.0
DEFAULT_TIMEZONE=Asia/Jakarta
JSON_BODY_LIMIT=1mb

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://istanabuah:istanabuah_dev_pass@127.0.0.1:5433/istanabuah?schema=public"
DB_POOL_LIMIT=20

# Redis
REDIS_URL="redis://127.0.0.1:6380"
REDIS_MAX_RETRIES=3
REDIS_CONNECT_TIMEOUT_MS=5000

# Security & Hashing
BCRYPT_ROUNDS=12

# Default Pengaturan Toko (di-seed ke tabel app_configs)
TAX_PERCENTAGE=0
LOW_STOCK_DEFAULT_THRESHOLD=5
RECEIPT_FOOTER="Terima kasih telah berbelanja di Istana Buah Semarang"

# Seed Data Awal (KHUSUS DEV — wajib diganti bila dipakai inisialisasi awal)
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=ChangeMeOwner123
SEED_OWNER_FULLNAME="Pemilik Istana Buah"
SEED_MANAGER_USERNAME=manager01
SEED_MANAGER_PASSWORD=ChangeMeManager123
SEED_MANAGER_FULLNAME="Manager Operasional"
SEED_CASHIER_USERNAME=kasir01
SEED_CASHIER_PASSWORD=ChangeMeKasir123
SEED_CASHIER_FULLNAME="Kasir Utama"

# Rate Limiting (diterapkan di M01-001)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=20

# Logging
LOG_LEVEL=info
