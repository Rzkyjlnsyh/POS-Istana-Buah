# Salin ke .env lalu isi. JANGAN commit file .env.
# Seluruh nilai konfigurasi berasal dari environment (tanpa hardcode di kode).

# Server
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
APP_NAME="Istana Buah Semarang"
APP_VERSION=1.0.0
DEFAULT_TIMEZONE=Asia/Jakarta

# Request body
JSON_BODY_LIMIT=1mb

# Rate Limiting (diterapkan di M01-001)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=20

# Logging
LOG_LEVEL=info

