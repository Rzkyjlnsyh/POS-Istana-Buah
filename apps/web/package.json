{
  "name": "@istana-buah/web",
  "version": "1.0.0",
  "private": true,
  "description": "Istana Buah POS - Frontend PWA (React + Vite + TypeScript)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "pnpm --filter @istana-buah/shared build",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretypecheck": "pnpm --filter @istana-buah/shared build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @istana-buah/shared build",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@istana-buah/shared": "workspace:*",
    "@tanstack/react-query": "^5.106.1",
    "@zxing/library": "^0.23.0",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.0",
    "autoprefixer": "^10.6.2",
    "axe-core": "^4.14.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.11",
    "vitest": "^2.1.0"
  }
}
