# Salin ke .env lalu isi. JANGAN commit file .env.
VITE_API_BASE_URL=http://localhost:3000/v1
VITE_APP_NAME="Istana Buah Semarang"
VITE_APP_BRAND="Istana Buah"
VITE_APP_VERSION=1.0.0
VITE_APP_YEAR=2026
VITE_DEV_PORT=5173
VITE_API_TIMEOUT_MS=15000
VITE_AUTH_STORAGE_KEY=istana_buah_refresh_token
# Sinkronisasi offline (ms) — dipakai di M11
VITE_OFFLINE_SYNC_INTERVAL=30000
VITE_PRODUCT_CACHE_TTL=300000
VITE_OFFLINE_DB_NAME=istana_buah_pos_db
VITE_OFFLINE_CATALOG_PAGE_SIZE=100
VITE_OFFLINE_SYNC_BATCH_SIZE=20
VITE_OFFLINE_MAX_RETRY_COUNT=5
VITE_OFFLINE_BACKOFF_BASE_MS=2000
VITE_OFFLINE_BACKOFF_MAX_MS=300000
VITE_OFFLINE_MAX_WARNING_HOURS=20
# Struk & printer thermal (M03-007) — fallback data struk bila server tidak mengirim receiptData
VITE_STORE_ADDRESS="Jl. Pandanaran No. 88, Semarang"
VITE_STORE_PHONE=024-8412345
VITE_RECEIPT_FOOTER="Terima kasih atas kunjungan Anda! Buah Segar Pilihan Keluarga."
VITE_PRINTER_DEFAULT_IP=192.168.1.200
VITE_PRINTER_DEFAULT_PORT=9100
VITE_PRINTER_NETWORK_TIMEOUT_MS=5000
# Zona waktu operasional toko & paginasi riwayat transaksi (M03-008)
VITE_STORE_TIMEZONE=Asia/Jakarta
VITE_STORE_UTC_OFFSET=+07:00
VITE_HISTORY_PAGE_SIZE=20
