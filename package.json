{
  "name": "istana-buah",
  "version": "1.0.0",
  "private": true,
  "description": "Sistem Kasir & Manajemen Operasional Istana Buah Semarang (monorepo)",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rzkyjlnsyh/POS-Istana-Buah.git"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "check:node": "node scripts/check-node-version.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commitlint": "commitlint",
    "dev": "pnpm -r --parallel --filter @istana-buah/api --filter @istana-buah/web dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.25.0",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "ts-node": "^10.9.2"
  }
}
